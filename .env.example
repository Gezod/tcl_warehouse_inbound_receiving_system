# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Connection (host connects via mapped port 5433)
DATABASE_URL=postgres://app:change-me@localhost:5433/warehouse
TEST_DATABASE_URL=postgres://app:change-me@localhost:5433/warehouse_test
POSTGRES_PORT=5433

# Timezone (for display and boundary of "today")
APP_TIMEZONE=Asia/Jakarta

# Authentication
SESSION_TTL_HOURS=8

# Seed Users (used by db:seed script)
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=OperatorPass123!
SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_PASSWORD=SupervisorPass123!

# Observability
LOG_LEVEL=info

# Docker Compose Database Settings
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse
